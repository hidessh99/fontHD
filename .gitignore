# ==============================================================================
# GoVPN Frontend (.gitignore) - Next.js 16, Bun, TypeScript, Turbopack
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.*

# Next.js Build Outputs & Cache
.next/
out/
build/
dist/
.turbo/
.swc/

# Environment Variables & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Allow committing example environment files
!.env.example
!.env.template

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel & Deployment Artifacts
.vercel/

# OS Generated Files (Windows & macOS)
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# IDE & Editor Config
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
