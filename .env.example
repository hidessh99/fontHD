# ==============================================================================
# GoVPN Environment Configuration Template (.env.example)
# Modeled after fontwahide flexible microservices architecture
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="GoVPN Enterprise"
NEXT_PUBLIC_APP_URL="https://hidessh.com"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Backend Unified Gateway / Monolith Fallback (Port 8080)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"

# --- Backend Microservices / Domain APIs ---
# Leave empty to automatically fallback to NEXT_PUBLIC_API_BASE_URL (Monolith mode)
# Or define dedicated service URLs (e.g. http://localhost:8081 or https://vpn.api.hidessh.com)
NEXT_PUBLIC_VPN_API_URL=
NEXT_PUBLIC_IAM_API_URL=
NEXT_PUBLIC_FINANCE_API_URL=
NEXT_PUBLIC_DNS_API_URL=
NEXT_PUBLIC_AI_API_URL=
NEXT_PUBLIC_K8S_API_URL=
NEXT_PUBLIC_MONITOR_API_URL=
NEXT_PUBLIC_NOTIFICATION_API_URL=
NEXT_PUBLIC_SUBSCRIPTION_API_URL=
NEXT_PUBLIC_SUPPORT_API_URL=
NEXT_PUBLIC_CONTENT_API_URL=

# Real-Time WebSocket Telemetry & Gateway
NEXT_PUBLIC_WS_GATEWAY_URL="ws://localhost:8080/ws"

# Cloudflare Turnstile CAPTCHA Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADOgaNLRGt1f6A6-"
TURNSTILE_SECRET_KEY="0x4AAAAAADOgaEsIKb-NTxKbqem-1NW0YUo"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true
